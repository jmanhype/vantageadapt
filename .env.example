# =============================================================================
# VantageAdapt Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# =============================================================================
# OpenAI Configuration
# =============================================================================
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# LangChain / LangSmith Configuration
# =============================================================================
# Enable LangChain tracing for debugging (true/false)
LANGCHAIN_TRACING_V2=true

# LangSmith API endpoint
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Get your LangSmith API key from https://smith.langchain.com/
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-api-key-here

# LangSmith project name for organizing traces
LANGCHAIN_PROJECT=vantageadapt

# =============================================================================
# Mem0 Configuration
# =============================================================================
# Get your Mem0 API key from https://mem0.ai/
MEM0_API_KEY=m0-your-mem0-api-key-here

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL database connection URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/vantageadapt

# Alternative async connection (for asyncpg)
DATABASE_URL_ASYNC=postgresql+asyncpg://user:password@localhost:5432/vantageadapt

# =============================================================================
# Application Configuration
# =============================================================================
# Environment mode (development, production, testing)
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# Trading Configuration
# =============================================================================
# Default trading theme if not specified via CLI
DEFAULT_TRADING_THEME=breakout trading

# Path to default trade data
DEFAULT_DATA_PATH=data/trade_data.pkl

# Performance thresholds
MIN_SHARPE_RATIO=1.5
MIN_SORTINO_RATIO=2.0
MIN_WIN_RATE=0.4
MAX_DRAWDOWN=-0.25

# =============================================================================
# API Configuration
# =============================================================================
# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# =============================================================================
# Security Configuration
# =============================================================================
# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production

# JWT algorithm
ALGORITHM=HS256

# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
